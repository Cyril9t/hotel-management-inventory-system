{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "imports": {
    "#shared/*": "./src/shared/*",
    "#modules/*": "./src/modules/*"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:worker": "nodemon --exec tsx src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "env:decrypt": "dotenvx decrypt -f .env.development",
    "env:encrypt": "dotenvx encrypt -f .env.development",
    "env:decrypt:prod": "dotenvx decrypt -f .env.production",
    "env:encrypt:prod": "dotenvx encrypt -f .env.production"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
