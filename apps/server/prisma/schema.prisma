generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  GENERAL_MANAGER
  RECEPTIONIST
  BAR_RESTAURANT_STAFF
  KITCHEN_STAFF
  STORE_MANAGER
}

model User {
  id                String   @id @default(cuid())
  fullName          String
  email             String   @unique
  passwordHash      String
  role              Role
  isActive          Boolean  @default(true)
  mustResetPassword Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
